{
  "name": "makerbay",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "admin",
    "infra",
    "packages/*",
    "modules/*/api",
    "modules/*/embed",
    "modules/*/web",
    "site",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck:api && npm run typecheck:ui",
    "typecheck:api": "tsc --noEmit -p tsconfig.check.json",
    "typecheck:ui": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p admin/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
