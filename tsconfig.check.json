{
  "//": "Lambda code is bundled by CDK's esbuild, which does not typecheck. Without this, a type error ships and is only found at runtime. Run: npm run typecheck",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["modules/*/api/src/**/*.ts", "packages/*/src/**/*.ts"],
  "exclude": ["packages/web-kit/**", "**/node_modules/**"]
}
