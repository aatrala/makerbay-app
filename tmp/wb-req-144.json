{"action":"evaluate","args":{"code":"(()=>{const set=(el,v)=>{const proto=HTMLInputElement.prototype;Object.getOwnPropertyDescriptor(proto,'value').set.call(el,v);el.dispatchEvent(new Event('input',{bubbles:true}));};const ins=[...document.querySelectorAll('main input')];const link=ins.find(i=>i.value.includes('chat.makerbay')||i.value==='Drain clearing'&&i.placeholder==='');if(ins[0].placeholder===''){set(ins[0],'https://chat.makerbay.app/booking?slug=harbour-test-plumbing');}const name=ins.find(i=>i.placeholder==='Standard cut');const nums=ins.filter(i=>i.type==='number');set(name,'Drain clearing');set(nums[0],'90');set(nums[1],'30');set(nums[2],'180');return JSON.stringify(ins.map(i=>({ph:i.placeholder,v:i.value})));})()"},"session":"makerbay-test"}